UNWIND [{id: 'CA-0001', kind: 'troubleshooting', scope: 'model', title: 'TX-2000: forwarding state stuck after SFP replacement', condition: 'After SFP replacement on a TX-2000: interface oper UP, RX optical power normal, alarms cleared, traffic counters stay at zero', recommendation: 'Do not replace the SFP again or reboot. Check that traffic counters increase; if they stay at zero, disable the interface, wait ~30 s, enable it again. Reboot only if that fails.', symptoms: ['oper_status=UP', 'rx_power=normal', 'alarms=cleared', 'rx_packets_delta=0'], trigger_event: 'SFP_REPLACED', confidence: 0.8, status: 'superseded', valid_from: '2026-03-12T09:27:00+02:00', valid_to: '2026-09-22T10:20:00+03:00', recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-001.json#seq=4', 'teams/TH-T-001.json#seq=6', 'teams/TH-T-001.json#seq=8', 'teams/TH-T-001.json#seq=10', 'email/TH-E-001.txt']}, {id: 'CA-0009', kind: 'troubleshooting', scope: 'model', title: 'TX-2000 below firmware 4.2: forwarding state stuck after SFP replacement', condition: 'After SFP replacement on a TX-2000 running firmware < 4.2: interface oper UP, RX optical power normal, alarms cleared, traffic counters stay at zero', recommendation: 'Do not replace the SFP again or reboot. Check that traffic counters increase; if they stay at zero, disable the interface, wait ~30 s, enable it again. Reboot only if that fails. Not needed on firmware 4.2+.', symptoms: ['oper_status=UP', 'rx_power=normal', 'alarms=cleared', 'rx_packets_delta=0'], trigger_event: 'SFP_REPLACED', applies_to_sw_below: '4.2', confidence: 0.9, status: 'active', valid_from: '2026-09-22T10:20:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-004.json#seq=1', 'teams/TH-T-004.json#seq=2']}, {id: 'CA-0008', kind: 'software_fix', scope: 'software', title: 'TX-2000 firmware 4.2 fixes forwarding re-init after optics swap', condition: 'TX-2000 running firmware 4.2 or later', recommendation: 'The interface disable/enable workaround after SFP replacement should not be needed. If traffic does not recover on 4.2+, treat it as a new fault.', confidence: 0.85, status: 'active', valid_from: '2026-09-22T10:15:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-004.json#seq=1']}, {id: 'CA-0002', kind: 'access', scope: 'site', title: 'SAL-03: locked barrier, key at Sallan Kyläkauppa', condition: 'Any visit to SAL-03 by road', recommendation: 'Private road Hirvasvaarantie is closed by a locked barrier 2.4 km before the mast. Pick up the key at Sallan Kyläkauppa (village centre), return it the same day.', confidence: 0.9, status: 'superseded', valid_from: '2024-10-22T14:31:00+03:00', valid_to: '2026-06-02T13:05:00+03:00', recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['email/TH-E-002.txt']}, {id: 'CA-0003', kind: 'access', scope: 'site', title: 'SAL-03: barrier keybox, code from NOC', condition: 'Any visit to SAL-03 by road', recommendation: 'Barrier on Hirvasvaarantie has a keybox. Call the NOC for the code before leaving (code is not stored here).', confidence: 0.95, status: 'active', valid_from: '2026-06-02T13:05:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['email/TH-E-003.txt']}, {id: 'CA-0010', kind: 'access', scope: 'site', title: 'SAL-03: winter road ploughed only to barrier', condition: 'Visit to SAL-03 in winter', recommendation: 'Road is ploughed only up to the barrier; bring a snowmobile for the last 2.4 km.', season_start: '11-01', season_end: '04-30', confidence: 0.8, status: 'active', valid_from: '2024-10-22T14:31:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['email/TH-E-002.txt']}, {id: 'CA-0007', kind: 'access', scope: 'site', title: 'KEM-07: close reindeer fence gate', condition: 'Any visit to KEM-07', recommendation: 'Access track crosses a reindeer fence at km 3. Always close the gate after passing.', confidence: 0.9, status: 'active', valid_from: '2025-05-12T16:20:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['email/TH-E-004.txt']}, {id: 'CA-0011', kind: 'access', scope: 'site', title: 'KEM-07: call landowner during calving season', condition: 'Visit to KEM-07 between mid-May and end of June', recommendation: 'Call the landowner before going (number in the site folder).', season_start: '05-15', season_end: '06-30', confidence: 0.85, status: 'active', valid_from: '2025-05-12T16:20:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['email/TH-E-004.txt']}, {id: 'CA-0004', kind: 'troubleshooting', scope: 'model', title: 'TX-3000 CRC errors after thunderstorm: clean connectors first', condition: 'TX-3000 port with rising CRC errors after a thunderstorm, optics normal', recommendation: 'Clean and inspect patch connectors at both ends before touching the line card.', symptoms: ['crc_errors_rising', 'rx_power=normal', 'after_storm'], confidence: 0.6, status: 'disputed', valid_from: '2026-07-18T14:35:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-002.json#seq=2', 'teams/TH-T-002.json#seq=4']}, {id: 'CA-0005', kind: 'troubleshooting', scope: 'model', title: 'TX-3000 CRC errors after power dip: reseat line card', condition: 'TX-3000 port with rising CRC errors after a thunderstorm or power dip', recommendation: 'Reseat the line card (takes the whole card\'s traffic down - schedule it).', symptoms: ['crc_errors_rising', 'rx_power=normal', 'after_storm'], confidence: 0.6, status: 'disputed', valid_from: '2026-07-18T14:38:00+03:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-002.json#seq=3', 'teams/TH-T-002.json#seq=6']}, {id: 'CA-0006', kind: 'environmental', scope: 'device', title: 'MWR-261 microwave link ices up in winter', condition: 'RSL_DEGRADED on MWR-261 radio-1 between November and March', recommendation: 'Expected icing. Traffic fails over to fiber. Do not dispatch unless degraded > 6 h or the fiber path is also down.', season_start: '11-01', season_end: '03-31', confidence: 0.85, status: 'active', valid_from: '2026-11-03T10:06:00+02:00', valid_to: null, recorded_at: '2026-11-06T21:00:00+02:00', extracted_by: 'extractor-v0 (synthetic ground truth)', source_refs: ['teams/TH-T-003.json#seq=2']}] AS row
