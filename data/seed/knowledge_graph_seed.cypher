// SoftwareVersion
UNWIND [{id: 'SW-TX2000-4.0', version: '4.0', released_at: '2018-04-10T00:00:00+03:00', release_notes: ''}, {id: 'SW-TX2000-4.1', version: '4.1', released_at: '2025-01-20T00:00:00+02:00', release_notes: 'Security fixes'}, {id: 'SW-TX2000-4.2', version: '4.2', released_at: '2026-08-01T00:00:00+03:00', release_notes: 'Fixes forwarding table re-initialisation after optical module hot-swap'}, {id: 'SW-TX3000-6.4', version: '6.4', released_at: '2025-06-02T00:00:00+03:00', release_notes: ''}, {id: 'SW-MW500-2.7', version: '2.7', released_at: '2024-11-15T00:00:00+02:00', release_notes: ''}, {id: 'SW-AG100-23.4', version: '23.4', released_at: '2025-03-01T00:00:00+02:00', release_notes: ''}] AS row
MERGE (n:SoftwareVersion {id: row.id})
