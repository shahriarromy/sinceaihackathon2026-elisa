// Elisa x Since AI 2026 - synthetic demo graph. Generated by generate_data.py
// Each statement ends with ';' on its own line end. Run with cypher-shell or load_neo4j.py.
// Conversations (Teams/email/SMS) are NOT in the graph: see the example_conversations folder. ContextAssertion.source_refs are paths inside it, e.g. teams/TH-T-001.json#seq=4.

DROP CONSTRAINT thread_id IF EXISTS;
DROP CONSTRAINT sourcemessage_id IF EXISTS;

CREATE CONSTRAINT accesspoint_id IF NOT EXISTS FOR (n:AccessPoint) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT contextassertion_id IF NOT EXISTS FOR (n:ContextAssertion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT event_id IF NOT EXISTS FOR (n:Event) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT metricseries_id IF NOT EXISTS FOR (n:MetricSeries) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT model_id IF NOT EXISTS FOR (n:Model) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT networkelement_id IF NOT EXISTS FOR (n:NetworkElement) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT person_id IF NOT EXISTS FOR (n:Person) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT port_id IF NOT EXISTS FOR (n:Port) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT region_id IF NOT EXISTS FOR (n:Region) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT sfp_id IF NOT EXISTS FOR (n:SFP) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT service_id IF NOT EXISTS FOR (n:Service) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT site_id IF NOT EXISTS FOR (n:Site) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT softwareversion_id IF NOT EXISTS FOR (n:SoftwareVersion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT workorder_id IF NOT EXISTS FOR (n:WorkOrder) REQUIRE n.id IS UNIQUE;
CREATE INDEX event_at IF NOT EXISTS FOR (n:Event) ON (n.at);
CREATE INDEX assertion_status IF NOT EXISTS FOR (n:ContextAssertion) ON (n.status);

// Region
UNWIND [{id: 'REG-UUS', name: 'Uusimaa'}, {id: 'REG-VS', name: 'Varsinais-Suomi'}, {id: 'REG-PIR', name: 'Pirkanmaa'}, {id: 'REG-PPO', name: 'Pohjois-Pohjanmaa'}, {id: 'REG-LAP', name: 'Lappi'}] AS row
MERGE (n:Region {id: row.id})
SET n += row {.*};
// Site
UNWIND [{id: 'HEL-01', name: 'Pasila hub', municipality: 'Helsinki', lat: 60.1987, lon: 24.933, site_type: 'hub'}, {id: 'ESP-02', name: 'Otaniemi cabinet', municipality: 'Espoo', lat: 60.1841, lon: 24.8301, site_type: 'street_cabinet'}, {id: 'TKU-01', name: 'Kupittaa hub', municipality: 'Turku', lat: 60.45, lon: 22.295, site_type: 'hub'}, {id: 'TKU-04', name: 'Kaarina rooftop', municipality: 'Kaarina', lat: 60.407, lon: 22.37, site_type: 'rooftop'}, {id: 'TRE-01', name: 'Hervanta hub', municipality: 'Tampere', lat: 61.45, lon: 23.85, site_type: 'hub'}, {id: 'TRE-03', name: 'Nokia mast', municipality: 'Nokia', lat: 61.478, lon: 23.509, site_type: 'rural_mast'}, {id: 'OUL-01', name: 'Linnanmaa hub', municipality: 'Oulu', lat: 65.059, lon: 25.466, site_type: 'hub'}, {id: 'OUL-05', name: 'Kiiminki mast', municipality: 'Oulu', lat: 65.13, lon: 25.73, site_type: 'rural_mast'}, {id: 'KUU-02', name: 'Kuusamo mast', municipality: 'Kuusamo', lat: 65.965, lon: 29.188, site_type: 'rural_mast'}, {id: 'ROV-01', name: 'Rovaniemi hub', municipality: 'Rovaniemi', lat: 66.503, lon: 25.729, site_type: 'hub'}, {id: 'SAL-03', name: 'Hirvasvaara mast', municipality: 'Salla', lat: 66.83, lon: 28.67, site_type: 'remote_mast'}, {id: 'KEM-07', name: 'Kemijärvi mast', municipality: 'Kemijärvi', lat: 66.713, lon: 27.43, site_type: 'remote_mast'}, {id: 'SOD-02', name: 'Sodankylä mast', municipality: 'Sodankylä', lat: 67.416, lon: 26.59, site_type: 'remote_mast'}, {id: 'INA-01', name: 'Inari mast', municipality: 'Inari', lat: 68.906, lon: 27.029, site_type: 'remote_mast'}] AS row
MERGE (n:Site {id: row.id})
SET n += row {.*};
// AccessPoint
UNWIND [{id: 'AP-HEL-01-DOOR', kind: 'badge_door', description: 'Main entrance, badge access granted by NOC'}, {id: 'AP-SAL-03-BARRIER', kind: 'barrier', description: 'Locked barrier at start of private road Hirvasvaarantie, 2.4 km before the mast'}, {id: 'AP-KEM-07-GATE', kind: 'gate', description: 'Reindeer fence gate at km 3 of the access track'}, {id: 'AP-INA-01-TRACK', kind: 'track', description: 'Unpaved access track, 1.1 km from road 4'}] AS row
MERGE (n:AccessPoint {id: row.id})
SET n += row {.*};
// Model
UNWIND [{id: 'TX-2000', name: 'TX-2000', vendor: 'Nordoptic', family: 'transmission', hw_generation: 'legacy', release_year: 2017}, {id: 'TX-3000', name: 'TX-3000', vendor: 'Nordoptic', family: 'transmission', hw_generation: 'current', release_year: 2021}, {id: 'MW-500', name: 'MW-500', vendor: 'Arctiwave', family: 'microwave_radio', hw_generation: 'current', release_year: 2020}, {id: 'AG-100', name: 'AG-100', vendor: 'Vasa Networks', family: 'aggregation_router', hw_generation: 'current', release_year: 2022}] AS row
