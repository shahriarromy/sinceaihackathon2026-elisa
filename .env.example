# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hackathon_secret_password
NEO4J_AUTH=neo4j/hackathon_secret_password

# LLM Configuration (OpenAI compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Service Endpoints (Internal Docker Compose network)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
RAG_MCP_URL=http://rag-mcp:8000/sse
TEAMS_MCP_URL=http://mcp-teams:8000/sse
EMAIL_MCP_URL=http://mcp-email:8000/sse
SMS_MCP_URL=http://mcp-sms:8000/sse
NEO4J_MCP_RO_URL=http://neo4j-mcp-ro:8000/sse
NEO4J_MCP_RW_URL=http://neo4j-mcp-rw:8000/sse
